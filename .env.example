# BreatheBetter AI — Environment Variables Template
# Copy to .env (or configure inside Vercel Project Settings -> Environment Variables).
# NEVER commit .env or .env.local to Git.

# ── Server Security & Database ───────────────────────────────────────────────
PORT=8000
JWT_SECRET=replace_with_a_long_random_secret_for_production
SQLITE_DB_PATH=

# Optional Hosted PostgreSQL / Supabase (see server/supabase-schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional External APIs (Server-Side Only — Never Exposed to Client JS) ───
# Open-Meteo AQI & Weather run live out of the box with zero API keys required.
IQAIR_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
