# BreatheBetter AI — Frontend Environment Variables Template
# Copy this file to .env.local and fill in optional values.

# Optional Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# App Mode (live | demo)
VITE_APP_MODE=live

# Optional API Keys (Open-Meteo live AQI & weather works without any keys)
VITE_OPENWEATHER_API_KEY=
VITE_IQAIR_API_KEY=
VITE_GEMINI_API_KEY=
